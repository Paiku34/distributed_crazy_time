%% Configurazione di deployment sulle VM del DSMT.
%%
%% Sovrascrive i valori di default di game_engine.app.src (che restano
%% quelli per lo sviluppo su localhost). Si applica con:
%%
%%   ERL_FLAGS="-name game1@10.2.1.15 -setcookie crazytime" \
%%     ../rebar3 shell --config config/vm.config
%%
%% Lo STESSO file va bene su entrambe le VM: cluster_manager filtra da
%% peer_nodes il nome del nodo locale.
[
 {game_engine, [
    %% Il broker gira sulla sola VM1: entrambe le VM puntano qui.
    %% Serve `loopback_users = none` in /etc/rabbitmq/rabbitmq.conf,
    %% altrimenti RabbitMQ rifiuta l'utente guest da un host remoto.
    {rabbitmq, #{
        host => "10.2.1.15",
        port => 5672,
        username => <<"guest">>,
        password => <<"guest">>,
        vhost => <<"/">>,
        prefetch => 10,
        retry_interval => 5000
    }},

    %% Denominatore del quorum: 3 nodi configurati -> maggioranza 2.
    %% Due nodi su VM1 e uno su VM2, cosi' una partizione fra le due VM
    %% lascia la maggioranza dal lato del gateway.
    {peer_nodes, ['game1@10.2.1.15', 'game2@10.2.1.15', 'game3@10.2.1.16']}
 ]},

 %% Porte fisse per la distribuzione Erlang (default: effimere e casuali).
 %% Servono a sapere cosa aprire sul firewall e a scrivere regole iptables
 %% mirate nel test di partizione.
 {kernel, [
    {inet_dist_listen_min, 9100},
    {inet_dist_listen_max, 9155}
 ]}
].
